{
  "expo": {
    "name": "Hasio",
    "slug": "hasio",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "hasio",
    "icon": "./assets/IconKitchen-Output/android/play_store_512.png",
    "userInterfaceStyle": "automatic",
    "sdkVersion": "54.0.0",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/IconKitchen-Output/android/play_store_512.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hasio.travel",
      "icon": "./assets/IconKitchen-Output/android/play_store_512.png",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Hasio needs access to your photos to save and share your travel moments.",
        "NSCameraUsageDescription": "Hasio needs access to your camera to capture travel moments.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/IconKitchen-Output/android/play_store_512.png",
        "backgroundColor": "#F5A623"
      },
      "package": "com.hasio.travel",
      "versionCode": 10,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/IconKitchen-Output/web/icon-192.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8859775e-cedf-45b7-aa94-3c7cbfb7be12"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image-picker",
      "expo-updates",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "autonomy",
    "extra": {
      "eas": {
        "projectId": "8859775e-cedf-45b7-aa94-3c7cbfb7be12"
      },
      "router": {}
    }
  }
}
